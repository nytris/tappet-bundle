{
    "name": "tappet/bundle",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Tappet\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tappet\\Bundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "symfony/config": "^5.0",
        "symfony/dependency-injection": "^5.0",
        "symfony/http-kernel": "^5.0",
        "symfony/yaml": "^5.0",
        "tappet/tappet": "^0.2.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-mockery": "^1.1",
        "phpunit/phpunit": "^10.2",
        "symfony/browser-kit": "^5.4",
        "symfony/framework-bundle": "^5.0"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    }
}
